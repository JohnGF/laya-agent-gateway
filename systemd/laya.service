[Unit]
Description=Laya System 1 Decision Daemon
After=network.target

[Service]
Type=simple
Environment=LAYA_DEVICE=cpu
Environment=LAYA_PORT=8791
WorkingDirectory=%h/.local/share/laya
ExecStart=%h/.local/share/laya/.venv/bin/python -m laya.serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
