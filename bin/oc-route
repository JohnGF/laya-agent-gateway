#!/usr/bin/env bash
# ==============================================================================
# oc-route: Pre-LLM System 1 model & session router for OpenCode
# ==============================================================================

set -euo pipefail

if command -v laya-router >/dev/null 2>&1; then
    ROUTER="laya-router"
else
    ROUTER="$(dirname "${BASH_SOURCE[0]}")/laya-router"
fi

if [[ $# -eq 0 ]]; then
    echo "Usage: oc-route <prompt> [extra opencode options...]"
    exit 1
fi

PROMPT="$1"
shift || true

ROUTE_OUTPUT=$("$ROUTER" route "$PROMPT" 2>/dev/null || echo "flash interactive")
TIER=$(echo "$ROUTE_OUTPUT" | awk '{print $1}')
MODE=$(echo "$ROUTE_OUTPUT" | awk '{print $2}')

case "$TIER" in
    flash_lite)
        MODEL="iaedu/iaedu-relay"
        COLOR="\033[1;32m"
        ;;
    flash)
        MODEL="opencode/gemini-3.8-flash"
        COLOR="\033[1;34m"
        ;;
    pro)
        MODEL="opencode/gemini-3.1-pro"
        COLOR="\033[1;35m"
        ;;
    *)
        MODEL="opencode/gemini-3.8-flash"
        COLOR="\033[1;34m"
        ;;
esac

echo -e "\033[1;36m[Laya Pre-Router]\033[0m Routed to ${COLOR}${TIER}\033[0m | Mode: \033[1;36m${MODE}\033[0m -> launching opencode with \033[1m${MODEL}\033[0m"

exec opencode --model "$MODEL" --prompt "$PROMPT" "$@"
